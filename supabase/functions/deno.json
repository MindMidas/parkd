{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await"]
    }
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "test": "deno test --allow-env=SUPABASE_FUNCTION_ALLOWED_ORIGINS **/*_test.ts"
  }
}
